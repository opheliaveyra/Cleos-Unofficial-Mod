<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice messages: asked for the first time the person holds the microphone button. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 拍照：调系统相机。声明了就要在启动相机前请求（Android 11 起没授权会抛 SecurityException）。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- get_location, only while a reply asks; asked for when the switch is turned on. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- What a TA says on its own, and letters arriving: asked for the first time there is one coming. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- set_alarm / set_timer, handed to the phone's clock app; granted on install, nothing to ask. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- The calendar tools; asked for when their switch is turned on. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- ReplyKeeper: a reply the person left before it came is finished instead of frozen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- CallService: a call with a TA goes on with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 虚拟屏探针：Android 14 要求投屏会话跑在 mediaProjection 类型的前台服务里。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 虚拟屏探针要查抖音和 Shizuku 是否安装（Android 11+ 的包可见性）。 -->
    <queries>
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".CleosApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cleos">

        <!-- 虚拟屏可行性探针：只做验证（见 ui/probe），不参与聊天。 -->
        <activity
            android:name=".ui.probe.VirtualScreenProbeActivity"
            android:exported="false"
            android:label="虚拟屏探针" />
        <service
            android:name=".ui.probe.MediaProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
            桌面图标：真正的启动器组件是下面这些 activity-alias（见 data/AppIcons）。
            MainActivity 自己不再有 MAIN/LAUNCHER —— 点哪一个 alias 进来的都是它；
            通知的 PendingIntent 仍然直接指向 .MainActivity，不受影响。

            每个 alias 的 label 都是 @string/app_name：换的只是图标，App 的名字不变。
            enabled 全写在 manifest 里（默认那个开、16 个图标的关），换图标就是由
            data/AppIcons 在运行时改写系统里的组件状态。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".LauncherDefault"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

